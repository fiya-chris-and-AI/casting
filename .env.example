# ==========================================================================
# CASTING — environment configuration
# --------------------------------------------------------------------------
# Copy:  cp .env.example .env.local
# .env.local is gitignored and must NEVER be committed — this repository is
# shared with the hackathon jury; real keys live only in .env.local.
#
# Every variable below is actually read by the code. The app authenticates
# with a plain Bearer token (the API key); no secret key is needed.
# ==========================================================================

# --------------------------------------------------------------------------
# 1. YouCam / Perfect Corp — required
# --------------------------------------------------------------------------
# Where to get it:
#   1) Register for the event on Devpost -> redeem code arrives by mail
#      https://youcam-api.devpost.com/register
#   2) Create a YouCam API account + verify mail
#      https://yce.perfectcorp.com/ai-api
#   3) API Console -> Account -> Redeem Code  (1,000 units, available instantly)
#   4) API Console -> API Keys -> create a key
#      https://yce.perfectcorp.com/api-console/en/api-keys/
#
# The key is sent as `Authorization: Bearer <key>` on every request.
YOUCAM_API_KEY=

# REST base URL. Change only if the docs name a different region.
YOUCAM_API_BASE_URL=https://yce-api-01.perfectcorp.com

# --------------------------------------------------------------------------
# 2. Unit-budget brake — protects the demo day and the judging window
# --------------------------------------------------------------------------
# One live run = 1 Apparel-VTO call per panel person (8 total, 2 units each).
# A run is refused (with a visible fallback to the precomputed demo run) if
# it would exceed this per-run cap — or if the REAL account balance, checked
# live via the YouCam credit API, no longer covers the reserve for the
# judging window (see lib/rate-limit.ts for the arithmetic).
YOUCAM_MAX_CALLS_PER_RUN=8

# Seconds after which a hanging VTO call is aborted and the tile shows its
# error state instead of silently waiting.
YOUCAM_REQUEST_TIMEOUT_SECONDS=45

# --------------------------------------------------------------------------
# 3. Demo safety
# --------------------------------------------------------------------------
# true = the app serves the precomputed demo run from the bundled seed and
# makes zero network calls. Plan B if the network dies during a recording.
DEMO_MODE=false

# --------------------------------------------------------------------------
# 3b. Live-run access gate
# --------------------------------------------------------------------------
# Access code for live runs; given to jurors in the Devpost testing
# instructions. Server-only — never expose via NEXT_PUBLIC_. The demo view
# (precomputed run, Compare, Report, Methods) stays public with no code.
# Leave empty for local dev: the gate is skipped when this is unset.
LIVE_ACCESS_CODE=

# --------------------------------------------------------------------------
# 4. Dev scripts only (scripts/*.mjs) — not read by the app
# --------------------------------------------------------------------------
# Second account used as a reserve while building the panel measurements.
# YOUCAM_ACCOUNT=backup switches the measurement scripts to the backup key.
YOUCAM_API_KEY_BACKUP=
YOUCAM_ACCOUNT=
